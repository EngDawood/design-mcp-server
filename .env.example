# design-mcp-server — environment variables
# All keys are OPTIONAL — the server works with the keyless providers
# (Iconify, SVG Repo*, OpenMoji, Wikimedia Commons, Storyset) without any.
# On Cloudflare Workers these are set with `wrangler secret put <NAME>`.

# Icons (Flaticon API v3 — attribution required)
FLATICON_API_KEY=

# Stock Photos
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Brand Logos
LOGO_DEV_TOKEN=

# Optional plain var (not a secret): public origin of this deployment,
# used to build Storyset recolor regeneration URLs.
PUBLIC_ORIGIN=

# * SVG Repo is experimental: it has no official API.
